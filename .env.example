# Cambiar de modelo = cambiar estas variables (no se toca codigo)
CLASSIFIER_MODEL=naive_bayes        # naive_bayes | keywords
HEATMAP_MODEL=kde                   # kde | frequency
SUMMARY_PROVIDER=auto               # auto | template | gemini | ollama | openai_compatible | anthropic

# Google Gemini (gratis en https://aistudio.google.com/apikey). Con la llave, "auto" usa Gemini
# para el resumen diario y el asistente; sin ella, todo funciona con plantillas y reglas.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.1-flash-lite

# Ejemplo Ollama local (modelo open source):
# SUMMARY_PROVIDER=ollama
# SUMMARY_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434

# Ejemplo Groq (modelos open source en la nube, tiene plan gratis):
# SUMMARY_PROVIDER=openai_compatible
# SUMMARY_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# Protege POST /api/v1/models/switch en produccion
# ADMIN_TOKEN=algo-secreto
